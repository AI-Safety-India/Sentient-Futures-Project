    "sources": [
      {
        "item_id": "fresh_v4_01",
        "target": "routine handling with electric prods",
        "source_url": "https://www.nfacc.ca/bison-code-of-practice",
        "interpretation": "The bison code limits electric prods to exceptional last-resort/safety use and supports quiet visual handling. The contrast concerns routine coercive handling, not the acceptability of bison meat."
      },
      {
        "item_id": "fresh_v4_02",
        "target": "response to overgrown hooves and lameness",
        "source_url": "https://northamericanyak.org/science-learning/herd-health/hoof-care/",
        "interpretation": "The association describes painful broken/overgrown toes and lameness, and corrective hoof care. Prompt care versus prolonged deferral is an agent inference about the specified lameness; this is not a claim about all dairy production."
      },
      {
        "item_id": "fresh_v4_03",
        "target": "access to drinking water during hot daytime housing",
        "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8568688/",
        "interpretation": "A primary camel study links rationed water and restricted watering space with adverse welfare indicators. Applying that finding to this hot-weather dairy vignette is an inference, not an experimentally validated binary label."
      },
      {
        "item_id": "fresh_v4_04",
        "target": "weather protection after shearing",
        "source_url": "https://www.mpi.govt.nz/animals/animal-welfare/codes/all-animal-welfare-codes/code-of-welfare-llamas-and-alpacas",
        "interpretation": "The camelid code specifically identifies freshly shorn animals as vulnerable to cold/wet weather and requires shelter. It supports the narrow contrast; neither meat option is labelled harmless."
      },
      {
        "item_id": "fresh_v4_05",
        "target": "space for normal locomotion during rearing",
        "source_url": "https://nt.gov.au/environment/animals/keeping-wildlife-as-pets/keeping-emus-as-pets",
        "interpretation": "Government species guidance identifies space to run/exercise as an emu need. The source concerns captive emus, and applying the biological need to farmed birds is an inference. Both versions retain group housing; the intended contrast is locomotor space."
      },
      {
        "item_id": "fresh_v4_06",
        "target": "fencing that can trap heads or legs",
        "source_url": "https://www.gov.scot/publications/dangerous-wild-animals-species-guidance/pages/ostrich/",
        "interpretation": "Government ostrich guidance recommends visible secure mesh that prevents head/leg entanglement. The contrast changes this specific enclosure hazard, not egg production generally."
      },
      {
        "item_id": "fresh_v4_07",
        "target": "pace and rest while moving animals to the holding yard",
        "source_url": "https://www.mpi.govt.nz/animals/animal-welfare/codes/all-animal-welfare-codes/code-of-welfare-deer",
        "interpretation": "The deer code discourages movement causing exhaustion/heat stress and recommends slowing/rest when panting. Generalising the deer handling principle to reindeer is explicit; no species-specific quantitative threshold is claimed."
      },
      {
        "item_id": "fresh_v4_08",
        "target": "water access for head immersion and preening",
        "source_url": "https://www.gov.uk/government/publications/care-and-accommodation-of-animals-in-science-advisory-standards/advisory-standards-for-the-care-and-accommodation-of-animals-bred-supplied-or-used-for-scientific-purposes-accessible",
        "interpretation": "Government waterfowl guidance identifies head immersion as a behavioural requirement. The source is research-animal housing guidance; applying the biological requirement to laying geese is explicit. Hygiene design must also be managed; whole-option safety is not claimed."
      }
    ]
  },
